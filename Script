import svgwrite as svg
height = 58
width = 7.25

temp_de_pause = 0.75

file_path = 'Instruction.txt'

def Pos(pine) :
    match pine :
        case 1:
            return 0.7
        case 2:
            return 1.81
        case 3:
            return 2.8
        case 4 :
            return 3.9
        case 5 :
            return 5.03
        case 6 :
            return 6.13

try:
    with open(file_path, 'r') as file:
        lines = [line.strip() for line in file]
except FileNotFoundError:
    print(f"Error: The file '{file_path}' was not found.")

var = [0, 0, 0, 0, 0]
i = 0


while i < len(lines):
    instruction = lines[i]
    if i < 4:
        var[i] = float(instruction)
    elif i == 4:
        rap = float(var[0])
        v_fwd = float(var[1])
        v_side = float(var[2])
        marge = float(var[3])
        temp = marge  
        print(marge)
        dwg = svg.Drawing('test.svg', size=(f"{width}cm", f"{height}cm"), profile='tiny')
    
        print("Lecture...")
        dwg.add(svg.shapes.Line((svg.cm(0), svg.cm(0)), (svg.cm(0), svg.cm(height))))
        dwg.add(svg.shapes.Line((svg.cm(0), svg.cm(0)), (svg.cm(width), svg.cm(0))))
        dwg.add(svg.shapes.Line((svg.cm(width), svg.cm(0)), (svg.cm(width), svg.cm(height))))  
        dwg.add(svg.shapes.Line((svg.cm(0), svg.cm(height)), (svg.cm(width), svg.cm(height))))

        dwg.add(svg.shapes.Circle((svg.cm(width/2 + 1.9), svg.cm(0.6)), svg.cm(0.3)))
        dwg.add(svg.shapes.Rect((svg.cm(0), svg.cm(0)), (svg.cm(1.1), svg.cm(0.9))))
        dwg.add(svg.shapes.Rect((svg.cm(0), svg.cm(height-0.9)), (svg.cm(1.1), svg.cm(0.9))))
        dwg.add(svg.shapes.Circle((svg.cm(1), svg.cm(2)), svg.cm(0.3)))
        dwg.add(svg.shapes.Circle((svg.cm(width/2 - 1.9), svg.cm(0.6)), svg.cm(0.3)))
        dwg.add(svg.shapes.Rect((svg.cm(width-1.1), svg.cm(0)), (svg.cm(1.1), svg.cm(0.9))))
        dwg.add(svg.shapes.Rect((svg.cm(width-1.1), svg.cm(height-0.9)), (svg.cm(1.1), svg.cm(0.9))))
        dwg.add(svg.shapes.Circle((svg.cm(width/2 + 1.9), svg.cm(height - 0.6)), svg.cm(0.3)))
        dwg.add(svg.shapes.Circle((svg.cm(width/2 - 1.9), svg.cm(height - 0.6)), svg.cm(0.3)))
        # on ne skip pas, on traite la première instruction
    else:
        match instruction:
            case "F":
                i += 1
                distance = lines[i]
                hauteur = float(distance) / v_fwd * rap
                dwg.add(svg.shapes.Rect((svg.cm(Pos(3)), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur
                temp += temp_de_pause * rap

            
            case "A" :
                i += 1
                distance = lines[i]
                hauteur = float(distance) / v_fwd * rap
                dwg.add(svg.shapes.Rect((svg.cm(Pos(4)), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur
                temp += temp_de_pause * rap

            case "R":
                i += 1
                distance = lines[i]
                hauteur = float(distance) / v_side * rap 
                dwg.add(svg.shapes.Rect((svg.cm(Pos(5)), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur
                temp += temp_de_pause * rap

            case "L":
                i += 1
                distance = lines[i]
                hauteur = float(distance) /v_side * rap
                dwg.add(svg.shapes.Rect((svg.cm(Pos(6)), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur
                temp += temp_de_pause * rap


            case "B":
                dwg.add(svg.shapes.Rect((svg.cm(Pos(2)), svg.cm(marge)), (svg.cm(0.5), svg.cm(temp-marge))))
                dwg.add(svg.shapes.Rect((svg.cm(Pos(1)), svg.cm(temp)), (svg.cm(0.5), svg.cm(height - marge -temp))))

            
            case "P":
                i += 1
                time = lines[i]
                hauteur = float(time) * rap
                temp += hauteur


    i += 1
print (f"Durée {temp / rap}")
if height-temp < marge :
    print("TROP LONGGGGGGG!!!!")
print("Done!")
dwg.save()  


