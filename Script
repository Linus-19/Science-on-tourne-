import svgwrite as svg
height = 58
width = 7.25

file_path = 'Instruction.txt'


print ("drawing circles")
try:
    with open(file_path, 'r') as file:
        lines = [line.strip() for line in file]
except FileNotFoundError:
    print(f"Error: The file '{file_path}' was not found.")

var = [0, 0, 0, 0, 0]
i = 0


while i < len(lines):
    instruction = lines[i]
    if i < 5:
        var[i] = float(instruction)
    elif i == 5:
        rap = float(var[0])
        rpm = float(var[1])
        ratio = float(var[2])
        temps_pour_tourner = float(var[3])
        marge = float(var[4])
        temp = marge  
        dwg = svg.Drawing('test.svg', size=(f"{width}cm", f"{height}cm"), profile='tiny')
        rpm_roues = rpm * ratio
        
        vitesse = rpm_roues/60 * 4.9 * 3.1416
        print (vitesse)
        print("Lecture...")
        dwg.add(svg.shapes.Line((svg.cm(0), svg.cm(0)), (svg.cm(0), svg.cm(height))))
        dwg.add(svg.shapes.Line((svg.cm(0), svg.cm(0)), (svg.cm(width), svg.cm(0))))
        dwg.add(svg.shapes.Line((svg.cm(width), svg.cm(0)), (svg.cm(width), svg.cm(height))))  
        dwg.add(svg.shapes.Line((svg.cm(0), svg.cm(height)), (svg.cm(width), svg.cm(height))))

        dwg.add(svg.shapes.Circle((svg.cm(width/2 + 1.9), svg.cm(0.6)), svg.cm(0.3)))
        dwg.add(svg.shapes.Rect((svg.cm(0), svg.cm(0)), (svg.cm(1.1), svg.cm(0.9))))
        dwg.add(svg.shapes.Circle((svg.cm(1), svg.cm(2)), svg.cm(0.3)))
        dwg.add(svg.shapes.Circle((svg.cm(width/2 - 1.9), svg.cm(0.6)), svg.cm(0.3)))
        dwg.add(svg.shapes.Rect((svg.cm(width-1.1), svg.cm(0)), (svg.cm(1.1), svg.cm(0.9))))
        dwg.add(svg.shapes.Circle((svg.cm(width/2 + 1.9), svg.cm(height - 0.6)), svg.cm(0.3)))
        dwg.add(svg.shapes.Circle((svg.cm(width/2 - 1.9), svg.cm(height - 0.6)), svg.cm(0.3)))
        # on ne skip pas, on traite la première instruction
    else:
        match instruction:
            case "F":
                i += 1
                distance = lines[i]
                hauteur = float(distance) / vitesse * rap
                dwg.add(svg.shapes.Rect((svg.cm(2.8), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                dwg.add(svg.shapes.Rect((svg.cm(5.03), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur

            
            case "A" :
                i += 1
                distance = lines[i]
                hauteur = float(distance) / vitesse * rap
                dwg.add(svg.shapes.Rect((svg.cm(3.9), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                dwg.add(svg.shapes.Rect((svg.cm(6.13), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur

            case "R":
                hauteur = temps_pour_tourner * rap
                dwg.add(svg.shapes.Rect((svg.cm(2.8), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur


            case "R+":
                hauteur = temps_pour_tourner/2 * rap
                dwg.add(svg.shapes.Rect((svg.cm(2.80), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                dwg.add(svg.shapes.Rect((svg.cm(6.13), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur

            case "L":
                hauteur = temps_pour_tourner * rap
                dwg.add(svg.shapes.Rect((svg.cm(5.03), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur


            case "L+":
                hauteur = temps_pour_tourner/2 * rap
                dwg.add(svg.shapes.Rect((svg.cm(3.9), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                dwg.add(svg.shapes.Rect((svg.cm(5.03), svg.cm(temp)), (svg.cm(0.5), svg.cm(hauteur))))
                temp += hauteur


            case "B":
                dwg.add(svg.shapes.Rect((svg.cm(1.81), svg.cm(marge)), (svg.cm(0.5), svg.cm(temp-marge))))
                dwg.add(svg.shapes.Rect((svg.cm(0.70), svg.cm(temp)), (svg.cm(0.5), svg.cm(height - marge -temp))))
            
            case "P":
                i += 1
                time = lines[i]
                hauteur = float(time) * rap
                temp += hauteur


    i += 1
print (f"Durée {temp / rap}")
print (temp)
print("Exporting")
dwg.save()  